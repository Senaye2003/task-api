# Postgres connection string.
# Local dev example:
#   postgres://USER:PASSWORD@localhost:5432/tasks_db
DATABASE_URL=

# Origin allowed by CORS. In production set this to your deployed frontend URL,
# e.g. https://task-api-frontend.vercel.app
CORS_ORIGIN=http://localhost:5173

# Port the server listens on. Render injects this automatically in production.
PORT=3000
